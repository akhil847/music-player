{
  "name": "Echo — Music Player",
  "short_name": "Echo",
  "description": "Ad-free personal music player with trending music, groups and your own files.",
  "id": "./",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0d0d12",
  "theme_color": "#0d0d12",
  "categories": ["music", "entertainment"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Trending", "url": "./#/trending", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Liked songs", "url": "./#/liked", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Search", "url": "./#/search", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
